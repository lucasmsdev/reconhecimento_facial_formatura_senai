# Configurações do Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Configurações de Reconhecimento Facial
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_CONFIDENCE_THRESHOLD=0.4
DEBOUNCE_SECONDS=5

# Configurações de Câmera
CAMERA_CAPTURE_INTERVAL_MS=500
CAMERA_JPEG_QUALITY=0.8
CAMERA_MAX_WIDTH=1280
CAMERA_MAX_HEIGHT=720

# Configurações de Síntese de Fala
TTS_LANGUAGE=pt-BR
TTS_RATE=0.9
TTS_PITCH=1.0
TTS_VOLUME=1.0

# Diretório de Alunos Cadastrados (usado apenas se S3_BUCKET_NAME não estiver definido)
ALUNOS_DIR=alunos_cadastrados

# CORS
CORS_ORIGINS=*

# AWS S3 (fotos e áudios dos alunos)
# Se S3_BUCKET_NAME estiver definido, o sistema busca do S3 em vez da pasta local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# Apenas necessário para credenciais temporárias (ex: AWS Academy / Learner Lab,
# que geram Access Key ID começando com "ASIA" em vez de "AKIA").
# Se sua chave começa com AKIA (usuário IAM normal), deixe esta linha vazia/removida.
AWS_SESSION_TOKEN=

# Estrutura esperada no bucket:
# alunos/<Nome do Aluno>/foto1.jpg
# alunos/<Nome do Aluno>/foto2.jpg
# alunos/<Nome do Aluno>/audio.mp3
